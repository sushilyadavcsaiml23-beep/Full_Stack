<%- include('partials/header', { title: 'Workouts' }) %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-0">My Workouts</h1>
    <p class="text-muted">Track your exercises and progress.</p>
  </div>
  <a href="/workout/new" class="btn btn-success">Add Workout</a>
</div>
<% if (workouts.length === 0) { %>
  <div class="alert alert-info">No workouts yet. Add your first workout.</div>
<% } else { %>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th>Type</th>
          <th>Date</th>
          <th>Duration</th>
          <th>Calories</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% workouts.forEach(workout => { %>
          <tr>
            <td><%= workout.workoutType %></td>
            <td><%= workout.workoutDate.toISOString().slice(0, 10) %></td>
            <td><%= workout.duration %> min</td>
            <td><%= workout.caloriesBurned %></td>
            <td>
              <a href="/workouts/<%= workout._id %>" class="btn btn-sm btn-outline-primary">View</a>
              <a href="/workouts/<%= workout._id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('partials/footer') %>
