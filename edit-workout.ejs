<%- include('partials/header', { title: 'Edit Workout' }) %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h3 mb-4">Edit Workout</h1>
        <form action="/workouts/<%= workout._id %>?_method=PUT" method="POST" class="needs-validation" novalidate>
          <div class="mb-3">
            <label for="workoutType" class="form-label">Workout Type</label>
            <input type="text" class="form-control" id="workoutType" name="workoutType" value="<%= workout.workoutType %>" readonly>
            <div class="form-text">Workout type cannot be changed after creation.</div>
          </div>
          <div class="mb-3">
            <label for="duration" class="form-label">Duration (minutes)</label>
            <input type="number" class="form-control" id="duration" name="duration" min="1" value="<%= workout.duration %>" required>
            <div class="invalid-feedback">Enter a valid duration.</div>
          </div>
          <div class="mb-3">
            <label for="caloriesBurned" class="form-label">Calories Burned</label>
            <input type="number" class="form-control" id="caloriesBurned" name="caloriesBurned" min="0" value="<%= workout.caloriesBurned %>" required>
            <div class="invalid-feedback">Enter calories burned.</div>
          </div>
          <div class="mb-3">
            <label for="workoutDate" class="form-label">Workout Date</label>
            <input type="date" class="form-control" id="workoutDate" name="workoutDate" value="<%= workout.workoutDate.toISOString().slice(0, 10) %>" required>
            <div class="invalid-feedback">Choose a workout date.</div>
          </div>
          <div class="mb-3">
            <label for="notes" class="form-label">Notes</label>
            <textarea class="form-control" id="notes" name="notes" rows="3"><%= workout.notes %></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Update Workout</button>
          <a class="btn btn-secondary" href="/workouts/<%= workout._id %>">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
